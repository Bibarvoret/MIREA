.calculator-background {
  position: relative; background-color: rgb(0, 0, 0); background-position: center top; background-repeat: no-repeat; --gradient-background: rgb(34 35 48 / 90%); --gradient-background-right: rgb(109 38 44 / 0%); --gradient-background-left: rgb(50 255 193 / 10%); --color-showcase-header: rgb(43 45 68 / 93%); --gradient-showcase-header-left: rgb(115 173 184 / 24.7%);
  &.tiled_background { background-repeat: repeat; }
  @media (max-width: 1920px) {
  background-size: auto;
}
  & .calculator-animated-background {
  position: absolute; min-width: 100%; max-width: 100%; min-height: 100%; width: auto; height: auto; overflow: hidden; pointer-events: none; display: flex; align-items: flex-start; justify-content: center;
  & > video { width: 1920px; }
}
  &.full_width_background {
  background-size: 100%;
  @media (min-width: 1930px) {
  & .calculator-animated-background > video { width: 100%; }
}
}
  & .calculator-wrapper { position: relative; max-width: 1000px; margin: 0px auto; backdrop-filter: blur(20px); text-shadow: rgb(0, 0, 0) 1px 1px 0px; background-position: initial; background-attachment: initial; background-origin: initial; background-clip: initial; background-color: rgba(22, 25, 32, 0.6); background-size: 1000px 3000px; background-repeat: no-repeat; background-image: linear-gradient(to bottom,var(--gradient-background),transparent 300px),radial-gradient(farthest-corner at top left,var(--gradient-background-left),transparent 600px),radial-gradient(farthest-side at top right,var(--gradient-background-right),transparent 500px); }
  & .pre-table-title, & .calculator-section-title { background: linear-gradient(90deg,var(--gradient-showcase-header-left) 0%,var(--color-showcase-header) 90%); }
  & .calculator-section-title {
  padding: 8px; border-radius: 6px; margin-bottom: 5px; font-weight: 700; display: flex; gap: 5px; align-items: center;
  & .octicon { filter: drop-shadow(rgb(0, 0, 0) 1px 1px); }
  & a {
  margin-left: auto; display: flex;
  &:not(:hover) { color: inherit; }
}
}
  & .table-products th { background-color: var(--color-showcase-header); }
  & .pre-table-title + .dt-container .dt-layout-row:first-child {
  color: rgb(246, 243, 247); background-color: var(--color-showcase-header); padding: 10px 30px 15px; margin: 0px;
  & .dt-input {
  color: rgb(255, 255, 255); background-color: rgba(255, 255, 255, 0.1);
  &:not(:focus) { border-color: transparent; }
}
  @media (max-width: 979px) {
  padding: 10px 15px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; margin-bottom: 5px;
}
}
  & .panel, & .table-bordered { --border-color: rgb(255 255 255 / 20%); border-color: var(--border-color); }
  & .panel, & .table-bordered tr { background: var(--gradient-background); }
  & .table-bordered tr:first-child td:first-child { border-top-left-radius: 5px; }
  & .table-bordered tr:first-child td:last-child { border-top-right-radius: 5px; }
  & .table-bordered tr:last-child td:first-child { border-bottom-left-radius: 5px; }
  & .table-bordered tr:last-child td:last-child { border-bottom-right-radius: 5px; }
  & .progress {
  display: flex; overflow: hidden; height: 10px; border-radius: 8px; background-color: hsl(from var(--gradient-showcase-header-left) h s 90% / 90%);
  & .progress-bar { border-top-right-radius: 8px; border-bottom-right-radius: 8px; background-color: hsl(from var(--color-showcase-header) h s 40% / 100%); }
}
  & .progress-desc {
  font-size: 16px; line-height: 2; display: flex;
  @media (max-width: 500px) {
  font-size: 14px;
}
}
  & .number { color: hsl(from var(--color-showcase-header) h s 70% / 100%); }
  & .support-above-footer { background-color: hsl(from var(--gradient-background) h s 30% / 100%); border-color: hsl(from var(--gradient-background) h s 60% / 50%); color: rgb(255, 255, 255); }
  & .table-products {
  & tbody { text-shadow: none; background: var(--body-bg-color); }
  & .dataTables_empty { height: 100vh; vertical-align: top; padding-top: 10px; }
}
}

